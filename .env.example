# Required: the token from Discord Developer Portal -> Bot -> Reset Token.
DISCORD_TOKEN=

# Optional comma-separated channel IDs. Empty means all channels and DMs.
ALLOWED_CHANNEL_IDS=

# upload: download and re-upload native attachments (default)
# link: skip downloads and send direct media URLs for Discord to embed
MEDIA_DELIVERY_MODE=upload

# Work limits and Discord upload limits.
MAX_LINKS_PER_MESSAGE=3
MAX_MEDIA_ITEMS_PER_LINK=20
MAX_ATTACHMENT_MB=20
MAX_ATTACHMENTS_PER_REPLY=10
PROCESS_CONCURRENCY=2
DOWNLOAD_CONCURRENCY=3

# Network and extractor settings.
FETCH_TIMEOUT_MS=30000
SNAPSAVE_RETRIES=3
SNAPSAVE_RETRY_DELAY_MS=500
# SNAPSAVE_PROXY=http://username:password@proxy.example.com:8080

# Short-lived result cache. Media is still downloaded fresh for Discord.
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=250

# Set true only if the bot also has Manage Messages permission.
SUPPRESS_ORIGINAL_EMBEDS=false
REPLY_ON_ERROR=true
LOG_LEVEL=info
